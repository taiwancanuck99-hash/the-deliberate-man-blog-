---
import BaseHead from '../components/BaseHead.astro';
import Quiz from '../components/Quiz.astro';

// You can use the site title from config if you have one, or hardcode it
const title = "The Drift Assessment | The Deliberate Man";
const description = "Take the 5-question assessment to discover your archetype and stop drifting.";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <!-- We override the body styling for this specific page to create a moody background for glassmorphism -->
  <body class="bg-brand-black text-brand-white min-h-screen relative font-sans antialiased selection:bg-brand-white selection:text-brand-black">
    
    <!-- Abstract dark background elements -->
    <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] bg-zinc-800/30 blur-[120px] rounded-full"></div>
      <div class="absolute bottom-[10%] -right-[10%] w-[60%] h-[60%] bg-zinc-900/40 blur-[100px] rounded-full"></div>
    </div>

    <!-- Header / Nav (Minimal) -->
    <header class="relative z-10 w-full py-8 px-6 lg:px-12 flex justify-center">
      <a href="/" class="text-xl font-serif font-bold tracking-widest uppercase hover:opacity-70 transition-opacity">
        The Deliberate Man
      </a>
    </header>

    <!-- Main Content -->
    <main class="relative z-10 w-full max-w-7xl mx-auto px-6 py-12 md:py-24">
      <Quiz />
    </main>

  </body>
</html>
